# ==============================================================================
# Coinpath Backend - Production Environment Variables Example
# ==============================================================================
# Copy these keys into your Render Dashboard under:
# Web Service -> Environment -> Environment Variables
# ==============================================================================

# Spring Profile (activates application-prod.yml)
SPRING_PROFILES_ACTIVE=prod

# Render dynamic port (Render sets this automatically; defaults to 8080 if not set)
PORT=8080

# ------------------------------------------------------------------------------
# 1. Neon Database (PostgreSQL)
# ------------------------------------------------------------------------------
# From your Neon Console -> Dashboard -> Connection Details
# Use the pooled connection endpoint (recommended for serverless)
DB_HOST=ep-calm-pine-b4cnbf2p-pooler.c-6.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=npg_I50ywLxJKURW

# Optional: You can provide the full JDBC URL directly instead of host/user/pass:
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-calm-pine-b4cnbf2p-pooler.c-6.us-east-2.aws.neon.tech:5432/neondb?sslmode=require

# Hikari Connection Pool settings (sized for Neon serverless / Render starter instance)
DB_POOL_SIZE=10
DB_MIN_IDLE=2

# ------------------------------------------------------------------------------
# 2. Upstash Redis (Cache & Idempotency)
# ------------------------------------------------------------------------------
# From your Upstash Console -> Redis Database -> Details
REDIS_HOST=your-database-id.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password
REDIS_SSL_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Confluent Cloud Kafka (Event Streaming)
# ------------------------------------------------------------------------------
# From Confluent Cloud Console -> Cluster Settings -> Endpoints: Bootstrap server
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-2.aws.confluent.cloud:9092

# From Confluent Cloud Console -> API Keys -> Create Cluster API Key
KAFKA_API_KEY=your_confluent_api_key
KAFKA_API_SECRET=your_confluent_api_secret

# Consumer group identifier
KAFKA_CONSUMER_GROUP=coinpath-prod-group

# ------------------------------------------------------------------------------
# 4. Security & JWT
# ------------------------------------------------------------------------------
# Generate a strong 256-bit or 512-bit Base64-encoded secret key
# (e.g. run: openssl rand -base64 64)
APP_JWT_SECRET=c2VjdXJlLWNvaW5wYXRoLWp3dC1zZWNyZXQta2V5LTM1NjgyOTM4NDc1OTIwMTkzODQ3NTkyMDE5Mzg0NzU=

